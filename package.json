{
	"name": "personal",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.11.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:css": "stylelint \"**/*.css\"",
		"lint:css:fix": "stylelint \"**/*.css\" --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@next/third-parties": "16.3.5",
		"motion": "13.2.0",
		"next": "^16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-draggable": "4.7.1",
		"react-icons": "^5.7.0",
		"react-rnd": "10.5.3",
		"react-selecto": "1.26.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.5",
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.9.6",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.1",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"unrs-resolver"
		]
	}
